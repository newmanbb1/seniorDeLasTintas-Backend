# Copiar a deploy.env y ajustar (deploy.env NO se commitea)
# cp deploy/deploy.env.example deploy/deploy.env

# VPS
VPS_HOST=187.127.249.238
VPS_USER=root
VPS_PORT=22

# Ruta REAL en el VPS (carpeta padre de seniorDeLasTintas-Backend/)
# Si no sabés cuál es, en el VPS: docker ps && find / -name docker-compose.yml 2>/dev/null
DEPLOY_PATH=/opt/senior-tintas

# Ramas a desplegar
BACKEND_BRANCH=main
FRONTEND_BRANCH=main

# Repos (HTTPS funciona sin deploy key; SSH si ya configuraste keys en el VPS)
BACKEND_REPO=https://github.com/newmanbb1/seniorDeLasTintas-Backend.git
FRONTEND_REPO=https://github.com/newmanbb1/frontend-senor-tintas.git

# Opcional: ejecutar seed tras deploy (solo primera vez o entornos demo)
RUN_SEED=false
